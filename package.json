{
  "name": "clarus-music",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "check": "npm run typecheck && npm run lint && npm run test:run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "perf:test": "node --test --test-concurrency=1 scripts/perf/fixtures/generate.test.mjs scripts/perf/fixtures/verify.test.mjs scripts/perf/fixtures/range-server.test.mjs",
    "perf:fixtures:generate": "node scripts/perf/fixtures/generate.mjs",
    "perf:fixtures:verify": "node scripts/perf/fixtures/verify.mjs",
    "perf:fixtures:serve": "node scripts/perf/fixtures/serve.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-regular-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/vue-fontawesome": "3.0.8",
    "@tanstack/vue-virtual": "^3.13.35",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "howler": "2.2.3",
    "pinia": "^4.0.2",
    "plyr": "^3.6.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/howler": "2.2.12",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
