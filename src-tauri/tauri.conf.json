{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Clarus Music",
  "version": "0.1.0",
  "identifier": "com.ovo3ovo3ovo.clarusmusic",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Clarus Music",
        "width": 1440,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' asset: ipc: http://ipc.localhost http://127.0.0.1:* https:; font-src 'self' data:; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: http: https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/audio-v1/**"]
      }
    }
  },
  "plugins": {
    "macos-fps": {
      "enabled": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
